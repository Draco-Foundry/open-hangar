{
  "format": 1,
  "revision": "2026-10-19",
  "paging": {
    "page": "page",
    "size": "pagesize",
    "pager": ".pager",
    "active": "a.active",
    "links": "a[href]"
  },
  "signedOut": {
    "redirect": { "source": "account\\/(connect|sign-?in)|\\/connect\\b", "flags": "i" },
    "page": {
      "source": "name=[\"']password[\"']|id=[\"']?password|account\\/connect",
      "flags": "i"
    }
  },
  "hangar": {
    "path": "/en/account/pledges",
    "pageSize": 10,
    "marker": { "source": "js-pledge-id", "flags": "" },
    "id": ".js-pledge-id",
    "card": ".row",
    "cardHas": ".js-pledge-name",
    "cardFallbacks": [".row", ".item"],
    "name": ".js-pledge-name",
    "value": ".js-pledge-value",
    "currency": ".js-pledge-currency",
    "item": ".item",
    "itemKind": ".kind",
    "itemName": ".title, .name, .item-name",
    "itemImage": ".image",
    "kindFallback": ".kind",
    "image": ".image",
    "gift": ".js-gift",
    "melt": ".js-reclaim",
    "date": ".date-col"
  },
  "buybacks": {
    "path": "/en/account/buy-back-pledges",
    "pageSize": 100,
    "empty": { "source": "no pledges available", "flags": "i" },
    "card": "article",
    "name": "h1",
    "cells": "dd",
    "cellLayouts": [
      { "min": 4, "date": 0, "contains": 2 },
      { "min": 2, "date": 0, "contains": 1 },
      { "min": 1, "date": 0 }
    ],
    "button": ".holosmallbtn, a[href*='reclaim'], a[href*='buy-back']",
    "ids": {
      "pledge": "data-pledgeid",
      "fromShip": "data-fromshipid",
      "toShip": "data-toshipid",
      "toSku": "data-toskuid"
    },
    "hrefId": { "source": "(?<id>\\d+)", "flags": "" },
    "image": "img",
    "background": "[style*=\"background\"]",
    "price": ".price, [class*=\"price\"], [class*=\"cost\"]",
    "upgraded": { "source": "\\s-\\s*upgraded\\s*$", "flags": "i" },
    "tokens": {
      "source": "you have (?<n>\\d+|no) opportunit(?:y|ies) to buy back",
      "flags": "i"
    },
    "noTokens": { "source": "^no$", "flags": "i" }
  },
  "buybackDetail": {
    "path": "/en/pledge/buyback/",
    "price": ".final-price[data-value]",
    "cents": "data-value",
    "currency": "data-currency",
    "title": ".content-block4 h1, #store-wrapper h1",
    "ships": ".package-listing.ship li",
    "info": ".info",
    "infoLine": { "source": "^(?<label>[^:]+):\\s*(?<value>.*)$", "flags": "" },
    "fields": {
      "name": ["ship", "vehicle"],
      "manufacturer": ["manufacturer"],
      "focus": ["focus"]
    },
    "image": "img",
    "also": ".package-listing.item li"
  },
  "names": {
    "ccu": { "source": "^\\s*upgrade\\s*-\\s*(?<from>.+?)\\s+to\\s+(?<to>.+?)\\s*$", "flags": "i" },
    "addon": { "source": "^\\s*add[\\s-]*on\\s*-", "flags": "i" },
    "coupon": { "source": "\\bcoupon\\b", "flags": "i" },
    "gameAccess": {
      "source": "\\b(star citizen|squadron 42)\\b.*\\b(digital|download|game|package)\\b",
      "flags": "i"
    },
    "paint": { "source": "\\b(paint|skin|livery|liveries|camo)\\b", "flags": "i" },
    "pack": { "source": "\\bpacks?\\b", "flags": "i" },
    "category": { "source": "^\\s*(?<prefix>.+?)\\s+[-–]\\s", "flags": "" }
  },
  "categories": {
    "package": { "source": "^(packages?|game\\s+packages?)$", "flags": "i" },
    "kinds": [
      { "pattern": { "source": "^(paints?|skins?|liver(y|ies))$", "flags": "i" }, "kind": "paint" },
      {
        "pattern": { "source": "^(gear|armou?r|weapons?|components?|fps)$", "flags": "i" },
        "kind": "addon"
      },
      { "pattern": { "source": "^subscribers?\\s+(store|vault)$", "flags": "i" }, "kind": "other" },
      {
        "pattern": {
          "source": "^(add[-\\s]?ons?|decorations?|posters?|flair|model\\s+ships?)$",
          "flags": "i"
        },
        "kind": "addon"
      },
      { "pattern": { "source": "^(packs?|combos?|bundles?)$", "flags": "i" }, "kind": "pack" }
    ],
    "ship": { "source": "^(standalone\\s+ships?|ships?|warbonds?)$", "flags": "i" }
  },
  "kinds": {
    "ship": { "source": "^ship$", "flags": "i" },
    "insurance": { "source": "insurance", "flags": "i" },
    "insuranceName": { "source": "\\binsurance\\b", "flags": "i" }
  },
  "insurance": {
    "fromName": {
      "lti": { "source": "\\blti\\b|lifetime", "flags": "i" },
      "years": { "source": "\\b(?<n>\\d+)\\s*[- ]?\\s*years?\\b", "flags": "i" },
      "months": { "source": "\\b(?<n>\\d+)\\s*[- ]?\\s*months?\\b", "flags": "i" }
    },
    "fromItem": {
      "lti": { "source": "life\\s*-?\\s*time|lifetime|\\blti\\b", "flags": "i" },
      "months": { "source": "(?<n>\\d+)\\s*month", "flags": "i" },
      "years": { "source": "(?<n>\\d+)\\s*year", "flags": "i" }
    }
  },
  "dates": {
    "label": { "source": "^\\s*created\\s*:?\\s*", "flags": "i" },
    "iso": { "source": "^(?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})", "flags": "" },
    "named": {
      "source": "^(?<month>[A-Za-z]{3})[a-z]*\\.?\\s+(?<day>\\d{1,2}),?\\s+(?<year>\\d{4})\\b",
      "flags": ""
    },
    "months": ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]
  },
  "account": {
    "path": "/en/account/dashboard",
    "keys": {
      "nickname": "nickname",
      "displayname": "displayname",
      "avatar": "avatar",
      "enlistedSince": "enlistedSince",
      "countryName": "countryName",
      "credits": "creditsData",
      "subscriber": "subscriberData",
      "concierge": "conciergeData"
    },
    "credit": {
      "variant": "variant",
      "value": "value",
      "symbol": "symbol",
      "label": "label",
      "currency": "currency"
    },
    "subscriber": { "type": "type", "frequency": "frequency" },
    "concierge": {
      "level": "conciergeCurrentLevel",
      "next": "conciergeNextLevel",
      "percent": "conciergeNextLevelPercentage"
    },
    "referral": {
      "code": "referralCode",
      "url": ["referralUrlCopy", "referralUrl"]
    }
  },
  "dossier": {
    "path": "/en/citizens/",
    "record": ".citizen-record .value",
    "org": ".main-org",
    "hidden": ".visibility-R",
    "info": ".info",
    "entry": ".entry",
    "label": ".label",
    "value": ".value",
    "sid": { "source": "sid", "flags": "i" },
    "rank": { "source": "rank", "flags": "i" },
    "name": "a.value",
    "redacted": { "source": "^redacted$", "flags": "i" },
    "orgLink": "a[href*=\"/orgs/\"]",
    "orgSid": { "source": "\\/orgs\\/(?<sid>[^/?#]+)", "flags": "" },
    "logo": ".thumb img"
  },
  "referrals": {
    "path": "/graphql",
    "operation": "GetReferralRecruitsList",
    "query": "query GetReferralRecruitsList($campaignId: ID!, $converted: Boolean!, $display: ReferralRecruitsListDisplay, $limit: Int!, $page: Int!, $sortBy: ReferralRecruitsListSortBy) {\n  referralRecruitsList(query: {campaignId: $campaignId, converted: $converted, display: $display, limit: $limit, page: $page, sortBy: $sortBy}) {\n    recruitsCount\n    prospectsCount\n    data { id displayName nickname avatar enlistedOn convertedOn }\n  }\n}",
    "variables": { "display": "ALL_TIME", "sortBy": "NEWEST" },
    "campaigns": { "current": "2", "legacy": "1" },
    "pageSize": 50
  },
  "subStore": {
    "path": "/graphql",
    "operation": "GetBrowseSkusByFilter",
    "query": "query GetBrowseSkusByFilter($query: SearchQuery, $storeFront: String = \"pledge\") {\n  store(browse: true, name: $storeFront) {\n    listing: search(query: $query) {\n      resources {\n        id name title subtitle url type\n        media { thumbnail { storeSmall slideshow } }\n        nativePrice { amount discounted }\n        price { amount discounted }\n        stock { available unlimited show level }\n        tags { name }\n        ... on TySku { label isWarbond isPackage }\n      }\n      count\n      totalCount\n    }\n  }\n}",
    "variables": {
      "storeFront": "pledge",
      "query": {
        "skus": {
          "filtersFromTags": {
            "tagIdentifiers": [],
            "facetIdentifiers": ["extras-subscribers-store"]
          },
          "products": [65]
        },
        "sort": { "field": "weight", "direction": "desc" }
      }
    },
    "pageSize": 100,
    "pageSizeMin": 20
  },
  "upgrade": {
    "path": "/pledge-store/api/upgrade/graphql",
    "storeList": {
      "operation": "initShipUpgrade",
      "query": "query initShipUpgrade { ships { id name flyableStatus msrp link skus { id title available price } } }"
    },
    "ships": {
      "operation": "initShipUpgrade",
      "query": "query initShipUpgrade { ships { id name owned msrp medias { productThumbMediumAndSmall } } app { mode isAnonymous } }"
    },
    "app": {
      "operation": "initShipUpgrade",
      "query": "query initShipUpgrade { app { mode isAnonymous } }"
    },
    "filter": {
      "operation": "filterShips",
      "query": "query filterShips($toId: Int, $fromFilters: [FilterConstraintValues]) {\n  from(to: $toId, filters: $fromFilters) {\n    ships {\n      id\n    }\n  }\n}\n",
      "variables": { "fromFilters": [] }
    },
    "price": {
      "operation": "getPrice",
      "query": "query getPrice($from: Int!, $to: Int!) {\n  price(from: $from, to: $to) {\n    amount\n    nativeAmount\n  }\n}\n"
    },
    "add": {
      "operation": "addToCart",
      "query": "mutation addToCart($from: Int!, $to: Int!) {\n  addToCart(from: $from, to: $to) {\n    jwt\n  }\n}\n"
    },
    "signedOut": {
      "source": "auth|log(ged)? ?in|sign(ed)? ?in|anonymous|unauthori[sz]ed|session",
      "flags": "i"
    },
    "buybackMode": "buyback"
  },
  "cart": {
    "path": "/en/store/pledge/cart",
    "signInPath": "/connect",
    "storePath": "/en/pledge",
    "authPath": "/api/account/v2/setAuthToken",
    "contextPath": "/api/ship-upgrades/setContextToken",
    "ticketPath": "/api/store/v2/cart/token",
    "cookie": "Rsi-Token",
    "tokenHeader": "x-rsi-token",
    "csrfHeader": "X-CSRF-TOKEN",
    "csrfTag": { "source": "<meta[^>]+name=[\"']csrf-token[\"'][^>]*>", "flags": "i" },
    "csrfValue": { "source": "content=[\"'](?<value>[^\"']+)[\"']", "flags": "i" },
    "context": {
      "fromShip": "fromShipId",
      "toShip": "toShipId",
      "toSku": "toSkuId",
      "pledge": "pledgeId"
    },
    "refusal": {
      "invalid": { "source": "invalid", "flags": "i" },
      "buyback": { "source": "buy[\\s-]?backs?", "flags": "i" },
      "upgrade": { "source": "upgrade", "flags": "i" }
    },
    "addMany": {
      "path": "/graphql",
      "operation": "AddCartMultiItemMutation",
      "query": "mutation AddCartMultiItemMutation($query: [CartAddInput!], $storeFront: String = \"pledge\") {\n  store(name: $storeFront) {\n    cart {\n      mutations {\n        addMany(query: $query) {\n          count\n          resources {\n            id\n            title\n          }\n        }\n      }\n    }\n  }\n}\n",
      "storeFront": "pledge"
    }
  }
}
