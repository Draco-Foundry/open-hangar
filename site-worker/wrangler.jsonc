{
  // openhangar.space on Cloudflare (open-hangar#201): the static site in ../site,
  // served as Workers static assets, so it gets Cloudflare's proxy, WAF, caching
  // and analytics like app.openhangar.space. Deployed by .github/workflows/pages.yml.
  //
  // The home page, the files it loads and the paths below come from the website
  // Worker (open-hangar-server, which also serves app.openhangar.space) through
  // the small script in src/index.js. Every file in ../site never runs the
  // script: the extension's status.json and rates.json, help.html and privacy.html
  // are plain files as before. If the website Worker fails, src/index.js gives
  // each path its fallback (the old static home page for / and /extension).
  "name": "openhangar-site",
  "main": "src/index.js",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "../site",
    "binding": "ASSETS",
    "html_handling": "none", // keep /privacy.html as it is (store listings link it)
    "run_worker_first": [
      "/",
      "/extension",
      "/store",
      "/api/store/*",
      // The website's newer pages, each a 404 there until its flag is on. Exact
      // paths: "/help" never matches the static Troubleshooting page, /help.html.
      "/ships",
      "/ships/*",
      "/whats-next",
      "/help",
      // The extension's public feeds (the website answers them, Origin-checked).
      "/api/game-status",
      "/api/ships",
      "/api/catalog",
      "/api/referral-events",
      "/api/known-issues",
      "/_astro/*",
      "/fonts/*",
      "/favicon.svg",
    ],
  },
  // EDGE: the website's edge gateway (open-hangar-edge), for its pages; APP: the
  // website itself, for its feeds and files and when the gateway can't answer.
  "services": [
    { "binding": "APP", "service": "open-hangar-server" },
    { "binding": "EDGE", "service": "open-hangar-edge" },
  ],
  // openhangar.space itself (switched from GitHub Pages, docs/SITE-CLOUDFLARE.md).
  // www is a proxied record plus a "www to root" redirect rule in the dashboard.
  "routes": [{ "pattern": "openhangar.space", "custom_domain": true }],
  "workers_dev": true,
  "env": {
    // A copy wired to the staging website, on workers.dev only, to check changes
    // before they reach openhangar.space.
    "staging": {
      "name": "openhangar-site-staging",
      "routes": [],
      "workers_dev": true,
      "services": [
        { "binding": "APP", "service": "open-hangar-server-staging" },
        { "binding": "EDGE", "service": "open-hangar-edge-staging" },
      ],
    },
  },
}
