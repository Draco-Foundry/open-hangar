{
  "name": "open-hangar-app",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "db:generate": "npx @better-auth/cli@latest generate --config auth.schema.ts --output migrations/0001_auth.sql --yes",
    "db:migrate:local": "wrangler d1 migrations apply open-hangar --local",
    "db:migrate:remote": "wrangler d1 migrations apply open-hangar --remote",
    "deploy": "astro build && wrangler deploy",
    "check": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/svelte": "^9.0.1",
    "astro": "^7.3.5",
    "better-auth": "^1.7.6",
    "kysely": "^0.29.6",
    "kysely-d1": "^0.4.0",
    "qrcode": "^1.5.4",
    "svelte": "^5.57.1",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/qrcode": "^1.5.6",
    "wrangler": "^4.143.0"
  },
  "private": true
}
