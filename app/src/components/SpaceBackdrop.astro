---
// The "Space" backdrop: three layers of stars drifting upward at different
// speeds (parallax), a few twinkling, over a nebula glow tinted by the palette.
// Stars are generated here on the server from a fixed seed, so every visit gets
// the same sky and the browser runs no script. Shown only when
// <html data-backdrop="space"> and the palette is dark; motion stops for
// prefers-reduced-motion.

const FIELD = 2000; // px; each layer tiles this square vertically while drifting

// Small seeded PRNG (mulberry32): same stars on every build.
function rng(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
// Mostly white, a few blue-white and warm stars, like a real sky.
const TINTS = ['255,255,255', '255,255,255', '255,255,255', '207,227,255', '255,231,194'];
function stars(count: number, seed: number, minAlpha: number) {
  const r = rng(seed);
  return Array.from({ length: count }, () => {
    const x = Math.round(r() * FIELD);
    const y = Math.round(r() * FIELD);
    const a = (minAlpha + r() * (1 - minAlpha)).toFixed(2);
    return `${x}px ${y}px rgba(${TINTS[Math.floor(r() * TINTS.length)]},${a})`;
  }).join(',');
}
const far = stars(380, 7, 0.25);
const mid = stars(130, 19, 0.4);
const near = stars(40, 31, 0.6);
---

<div class="space" aria-hidden="true">
  <div class="nebula"></div>
  <div class="layer far" style={`--stars:${far}`}></div>
  <div class="layer mid" style={`--stars:${mid}`}></div>
  <div class="layer near" style={`--stars:${near}`}></div>
</div>

<style is:global>
  .space {
    display: none;
  }
  /* Dark palettes only: stars on a light page look like dust. */
  [data-backdrop='space']:not([data-palette='origin'], [data-palette='crusader'], [data-palette='cnou']) .space {
    display: block;
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  /* Let the sky show through: <html> keeps the palette colour underneath. */
  [data-backdrop='space']:not([data-palette='origin'], [data-palette='crusader'], [data-palette='cnou']) body {
    background-color: transparent;
  }
  /* Panels a touch see-through (Glass keeps its own frosted look). */
  :where([data-backdrop='space']:not([data-palette='origin'], [data-palette='crusader'], [data-palette='cnou']))
    :is(.card, .stat) {
    background: color-mix(in srgb, var(--panel) 90%, transparent);
  }

  .space .nebula {
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(38% 30% at 72% 22%, color-mix(in srgb, var(--accent) 55%, transparent), transparent 70%),
      radial-gradient(34% 28% at 20% 70%, color-mix(in srgb, var(--accent) 35%, #d946ef), transparent 70%),
      radial-gradient(25% 20% at 55% 55%, color-mix(in srgb, var(--accent) 25%, #22d3ee), transparent 70%);
    filter: blur(60px);
    opacity: 0.22;
    animation: oh-breathe 40s ease-in-out infinite alternate;
  }
  /* One star per box-shadow; ::after repeats the field below for a seamless loop. */
  .space .layer,
  .space .layer::after {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 50%;
    background: transparent;
    box-shadow: var(--stars);
  }
  .space .layer::after {
    content: '';
    top: 2000px;
    width: 100%;
    height: 100%;
  }
  .space .far {
    width: 1px;
    height: 1px;
    animation: oh-drift 260s linear infinite;
  }
  .space .mid {
    width: 1.5px;
    height: 1.5px;
    animation:
      oh-drift 170s linear infinite,
      oh-twinkle 6s ease-in-out infinite alternate;
  }
  .space .near {
    width: 2px;
    height: 2px;
    animation: oh-drift 110s linear infinite;
  }
  @keyframes oh-drift {
    to {
      transform: translateY(-2000px);
    }
  }
  @keyframes oh-twinkle {
    to {
      opacity: 0.55;
    }
  }
  @keyframes oh-breathe {
    to {
      opacity: 0.32;
      transform: scale(1.06);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .space .nebula,
    .space .layer {
      animation: none;
    }
  }
</style>
