---
import Base from '../layouts/Base.astro';
import { countdown, upcoming } from '../lib/events';
import {
  commLinks,
  conceptShips,
  funding,
  gameVersion,
  recentShipChanges,
  refreshShipChanges,
  rsiStatus,
} from '../lib/live';
import { latestSnapshotForUser } from '../lib/accounts';

export const prerender = false;
const user = Astro.locals.user;

const [version, status, fund, news] = await Promise.all([gameVersion(), rsiStatus(), funding(), commLinks()]);
await refreshShipChanges().catch(() => null);
const [changes, concepts] = await Promise.all([recentShipChanges(8), conceptShips(5)]);
const events = upcoming();
const nextToken = events.find((e) => e.name.startsWith('Buy-back'));

// Signed in: a quick look at their synced hangar.
let mine: { count: number; melt: number; lti: number; synced: number } | null = null;
if (user) {
  const row = await latestSnapshotForUser(user.id);
  if (row) {
    try {
      const items: { value?: number; insurance?: string }[] = JSON.parse(row.payload)?.sources?.hangar?.items || [];
      mine = {
        count: items.length,
        melt: items.reduce((a, p) => a + (Number.isFinite(p.value) ? (p.value as number) : 0), 0),
        lti: items.filter((p) => p.insurance === 'LTI').length,
        synced: row.synced_at,
      };
    } catch {
      /* show the connect prompt instead */
    }
  }
}

const usd = (n: number, d = 0) =>
  '$' + n.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
const compact = (n: number) =>
  n >= 1e9
    ? `$${(n / 1e9).toFixed(3)}B`
    : n >= 1e6
      ? `$${(n / 1e6).toFixed(1)}M`
      : n >= 1e3
        ? `$${Math.round(n / 1e3)}K`
        : usd(n);
const ago = (t: number) => {
  const m = Math.round((Date.now() - t) / 60000);
  return m < 1 ? 'just now' : m < 60 ? `${m} min ago` : m < 1440 ? `${Math.round(m / 60)} h ago` : `${Math.round(m / 1440)} d ago`;
};
// Day labels read in UTC: RSI and the wiki give release and news dates as UTC
// days, and a local time zone would shift them to the day before.
const day = (s: string) =>
  s
    ? new Date(/^\d{4}-\d{2}-\d{2}$/.test(s) ? `${s}T12:00:00Z` : s).toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        timeZone: 'UTC',
      })
    : '';
const statusText = (s: string | null | undefined) =>
  s === 'operational' ? 'All systems go' : s === 'down' ? 'Outage' : s ? 'Some issues' : 'Unknown';
const statusClass = (s: string | null | undefined) => (s === 'operational' ? 'good' : s ? 'bad' : '');
const today = fund.value?.days.at(-1);
const week = fund.value?.days.slice(-7) ?? [];
const weekMax = Math.max(1, ...week.map((d) => d.amount));
const priceClass = (c: { kind: string; old_value: string | null; new_value: string | null }) =>
  c.kind !== 'price' ? 'muted' : Number(c.new_value) > Number(c.old_value) ? 'up' : 'down';
const changeText = (c: { kind: string; old_value: string | null; new_value: string | null }) =>
  c.kind === 'new'
    ? `New${c.new_value ? ` · ${usd(Number(c.new_value))}` : ''}`
    : c.kind === 'price'
      ? `${c.old_value ? usd(Number(c.old_value)) : '—'} → ${c.new_value ? usd(Number(c.new_value)) : '—'}`
      : `${c.old_value || '—'} → ${c.new_value}`;
---

<Base>
  {
    !user && (
      <section class="hero">
        <h1>Your Star Citizen Hangar, Anywhere</h1>
        <p class="lead">
          Live game status, store changes and news, plus your own hangar synced from the Open Hangar extension. It works
          fully offline too; syncing is your choice.
        </p>
        <p class="cta">
          <a class="btn" href="/sign-up">
            Create Account
          </a>
          <a class="btn secondary" href="/sign-in">
            Sign In
          </a>
          <a class="btn secondary" href="https://openhangar.space">
            Get the Extension
          </a>
        </p>
      </section>
    )
  }

  <section class="pulse" aria-label="Live Star Citizen status">
    <div class="stat">
      <div class="lbl"><span class="dot live"></span> Live build</div>
      <div class="big" id="p-version">{version.value?.version ?? '—'}</div>
      <div class="sub muted">{version.value?.released ? `since ${day(version.value.released)}` : ''}</div>
    </div>
    <div class="stat">
      <div class="lbl">RSI services</div>
      <div class={`big ${statusClass(status.value?.summary)}`} id="p-status">{statusText(status.value?.summary)}</div>
      <div class="sub muted" id="p-systems">
        {(status.value?.systems ?? []).map((s) => `${s.name}: ${s.status}`).join(' · ')}
      </div>
    </div>
    <div class="stat">
      <div class="lbl">Funding today</div>
      <div class="big" id="p-today">{today ? compact(today.amount) : '—'}</div>
      <div class="spark" aria-hidden="true">
        {
          week.map((d) => (
            <i
              style={`height:${Math.max(8, Math.round((d.amount / weekMax) * 100))}%`}
              title={`${d.date}: ${usd(d.amount)}`}
            />
          ))
        }
      </div>
    </div>
    <div class="stat">
      <div class="lbl">Raised all time</div>
      <div class="big" id="p-total">{fund.value ? compact(fund.value.total) : '—'}</div>
      <div class="sub muted" id="p-citizens">
        {fund.value ? `${fund.value.citizens.toLocaleString('en-US')} citizens` : ''}
      </div>
    </div>
    <div class="stat">
      <div class="lbl">Next buy-back token</div>
      <div class="big">{nextToken ? countdown(nextToken.t) : '—'}</div>
      <div class="sub muted">One per quarter, no roll-over</div>
    </div>
  </section>
  <p class="updated muted">Live data refreshes every minute · <span id="p-at">updated just now</span></p>

  <section class="board">
    <div class="card">
      <h2>Your Hangar</h2>
      {
        !user ? (
          <p class="muted">
            <a href="/sign-in">Sign in</a> and sync the extension to see your pledges, value and changes here.
          </p>
        ) : !mine ? (
          <p class="muted">
            Nothing synced yet. <a href="/link">Connect your extension</a>, then press Sync.
          </p>
        ) : (
          <>
            <div class="kv">
              <span class="muted">Pledges</span>
              <b>{mine.count}</b>
            </div>
            <div class="kv">
              <span class="muted">Melt value</span>
              <b>{usd(mine.melt, 2)}</b>
            </div>
            <div class="kv">
              <span class="muted">With LTI</span>
              <b>{mine.lti}</b>
            </div>
            <div class="kv">
              <span class="muted">Last synced</span>
              <b>{ago(mine.synced)}</b>
            </div>
            <p>
              <a href="/hangar">Open my hangar →</a>
            </p>
          </>
        )
      }
    </div>

    <div class="card">
      <h2>Latest Comm-Links</h2>
      {
        news.value?.length ? (
          <ul class="list">
            {news.value.slice(0, 6).map((n) => (
              <li>
                <a href={n.url} target="_blank" rel="noopener">
                  {n.title}
                </a>
                <span class="muted">{day(n.date)}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="muted">News is unavailable right now.</p>
        )
      }
      <p class="credit muted">Via the Comm-Link feed at leonick.se</p>
    </div>

    <div class="card">
      <h2>Store Changes</h2>
      {
        changes.length ? (
          <ul class="list">
            {changes.map((c) => (
              <li>
                <span>{c.name}</span>
                <span class={priceClass(c)}>{changeText(c)}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="muted">
            Watching the ship list for new ships and price changes. The first ones show up after the next weekly update.
          </p>
        )
      }
      {
        concepts.length > 0 && (
          <>
            <h3>Biggest Concept Ships</h3>
            <ul class="list">
              {concepts.map((c) => (
                <li>
                  <span>{c.name}</span>
                  <span class="muted">{usd(c.msrp)}</span>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>

    <div class="card">
      <h2>Coming Up</h2>
      {
        events.length ? (
          <ul class="list">
            {events.map((e) => (
              <li>
                <span>{e.name}</span>
                <span class="muted">
                  {day(e.date)} · {countdown(e.t)}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="muted">No announced dates right now.</p>
        )
      }
    </div>
  </section>
</Base>

<script>
  const fmt = (n: number) =>
    n >= 1e9
      ? `$${(n / 1e9).toFixed(3)}B`
      : n >= 1e6
        ? `$${(n / 1e6).toFixed(1)}M`
        : n >= 1e3
          ? `$${Math.round(n / 1e3)}K`
          : `$${Math.round(n)}`;
  const set = (id: string, text: string) => {
    const el = document.getElementById(id);
    if (el && text) el.textContent = text;
  };
  let last = Date.now();
  async function refresh() {
    try {
      const r = await fetch('/api/pulse', { cache: 'no-store' });
      const p: {
        version: string | null;
        status: string | null;
        systems: { name: string; status: string }[];
        fundingToday: number | null;
        fundingTotal: number | null;
        citizens: number | null;
      } = await r.json();
      if (p.version) set('p-version', p.version);
      if (p.status) {
        const ok = p.status === 'operational';
        set('p-status', ok ? 'All systems go' : p.status === 'down' ? 'Outage' : 'Some issues');
        document.getElementById('p-status')?.classList.toggle('good', ok);
        document.getElementById('p-status')?.classList.toggle('bad', !ok);
        set('p-systems', p.systems.map((s: { name: string; status: string }) => `${s.name}: ${s.status}`).join(' · '));
      }
      if (p.fundingToday != null) set('p-today', fmt(p.fundingToday));
      if (p.fundingTotal != null) set('p-total', fmt(p.fundingTotal));
      if (p.citizens) set('p-citizens', `${p.citizens.toLocaleString('en-US')} citizens`);
      last = Date.now();
    } catch {
      /* keep the last values */
    }
  }
  setInterval(refresh, 60_000);
  setInterval(() => {
    const s = Math.round((Date.now() - last) / 1000);
    set('p-at', s < 10 ? 'updated just now' : s < 60 ? `updated ${s}s ago` : `updated ${Math.round(s / 60)} min ago`);
  }, 5_000);
</script>

<style>
  .hero {
    padding: 36px 0 8px;
    max-width: 760px;
  }
  .hero h1 {
    font-size: 40px;
    line-height: 1.12;
  }
  .lead {
    font-size: 18px;
    color: var(--muted);
  }
  .cta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .pulse {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 12px;
    margin-top: 24px;
  }
  .lbl {
    font-size: 13px;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .big {
    font-size: 26px;
    font-weight: 700;
    margin: 2px 0;
  }
  .big.good {
    color: var(--good);
  }
  .big.bad {
    color: var(--bad);
  }
  .sub {
    font-size: 12px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--good);
  }
  .dot.live {
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--good) 70%, transparent);
    }
    70% {
      box-shadow: 0 0 0 8px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  .spark {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 26px;
    margin-top: 4px;
  }
  .spark i {
    flex: 1;
    background: var(--accent);
    opacity: 0.75;
    border-radius: 2px 2px 0 0;
  }
  .updated {
    font-size: 12px;
    margin: 8px 0 0;
  }
  .board {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 14px;
    margin-top: 18px;
  }
  .board h2 {
    margin-top: 0;
  }
  .board h3 {
    font-size: 15px;
    margin: 16px 0 6px;
  }
  .kv {
    display: flex;
    justify-content: space-between;
    padding: 6px 0;
    border-bottom: 1px solid var(--line);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .list li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 7px 0;
    border-bottom: 1px solid var(--line);
  }
  .list li:last-child {
    border-bottom: 0;
  }
  .list a {
    color: var(--text);
    text-decoration: none;
  }
  .list a:hover {
    color: var(--link);
    text-decoration: underline;
  }
  .list .muted {
    white-space: nowrap;
    font-size: 13px;
  }
  .up {
    color: var(--bad);
    white-space: nowrap;
  }
  .down {
    color: var(--good);
    white-space: nowrap;
  }
  .credit {
    font-size: 12px;
    margin: 10px 0 0;
  }
</style>
