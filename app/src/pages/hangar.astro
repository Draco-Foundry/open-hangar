---
import Base from '../layouts/Base.astro';
import { db } from '../lib/sync';

export const prerender = false;
const user = Astro.locals.user!;

type Item = {
  id?: string;
  name?: string;
  kind?: string;
  value?: number;
  insurance?: string | null;
  giftable?: boolean;
  date?: string;
};
const row = await db()
  .prepare('select synced_at, payload from hangar_snapshot where user_id = ?')
  .bind(user.id)
  .first<{ synced_at: number; payload: string }>();
let items: Item[] = [];
let buybacks = 0;
if (row) {
  try {
    const data = JSON.parse(row.payload);
    items = Array.isArray(data?.sources?.hangar?.items) ? data.sources.hangar.items : [];
    buybacks = Array.isArray(data?.sources?.buybacks?.items) ? data.sources.buybacks.items.length : 0;
  } catch {
    /* a bad payload just shows as empty */
  }
}
const melt = items.reduce((a, p) => a + (Number.isFinite(p.value) ? (p.value as number) : 0), 0);
const kinds = Object.entries(
  items.reduce<Record<string, number>>((m, p) => ((m[p.kind || 'other'] = (m[p.kind || 'other'] || 0) + 1), m), {}),
).sort((a, b) => b[1] - a[1]);
const lti = items.filter((p) => p.insurance === 'LTI').length;
const top = items
  .filter((p) => Number.isFinite(p.value))
  .sort((a, b) => (b.value as number) - (a.value as number))
  .slice(0, 25);
const money = (n: number) => '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const name = (p: Item) => String(p.name || '').replace(/^\s*.+?\s+[-–]\s/, '');
---

<Base title="My hangar">
  <h1>My hangar</h1>
  {
    !row ? (
      <div class="card">
        <p>Nothing synced yet.</p>
        <p class="muted">
          <a href="/link">Connect your extension</a>, then press <strong>Sync now</strong> in it. Your hangar shows
          up here.
        </p>
      </div>
    ) : (
      <>
        <p class="muted">Last synced {new Date(row.synced_at).toLocaleString('en-US')}</p>
        <div class="stat-grid">
          <div class="stat">
            <div class="big">{items.length}</div>
            <div class="lbl">pledges</div>
          </div>
          <div class="stat">
            <div class="big">{money(melt)}</div>
            <div class="lbl">melt value</div>
          </div>
          <div class="stat">
            <div class="big">{lti}</div>
            <div class="lbl">with LTI</div>
          </div>
          <div class="stat">
            <div class="big">{buybacks}</div>
            <div class="lbl">buy-backs</div>
          </div>
        </div>
        <h2>By type</h2>
        <p>
          {kinds.map(([k, n]) => (
            <span class="pill">
              {k} <b>{n}</b>
            </span>
          ))}
        </p>
        <h2>Most valuable pledges</h2>
        <table>
          <thead>
            <tr>
              <th>Pledge</th>
              <th>Type</th>
              <th>Insurance</th>
              <th class="num">Melt value</th>
            </tr>
          </thead>
          <tbody>
            {top.map((p) => (
              <tr>
                <td>{name(p)}</td>
                <td class="muted">{p.kind}</td>
                <td>{p.insurance || '—'}</td>
                <td class="num">{money(p.value as number)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )
  }
</Base>

<style>
  .pill {
    display: inline-block;
    margin: 0 6px 6px 0;
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 12px;
    text-transform: capitalize;
  }
</style>
