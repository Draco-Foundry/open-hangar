---
import Base from '../layouts/Base.astro';
import { discordEnabled } from '../lib/auth';

export const prerender = false;
// Only same-site paths after sign-in (no open redirects).
const raw = Astro.url.searchParams.get('next') || '/hangar';
const next = raw.startsWith('/') && !raw.startsWith('//') ? raw : '/hangar';
if (Astro.locals.user) return Astro.redirect(next);
const discord = discordEnabled();
---

<Base title="Sign In">
  <h1>Sign In</h1>
  <div class="card" style="max-width:460px">
    {
      discord && (
        <>
          <button type="button" class="discord" data-social="discord">
            Continue with Discord
          </button>
          <p class="or muted">or with email</p>
        </>
      )
    }
    <form class="form" id="f" data-next={next}>
      <label>Username or Email<input name="login" required autocomplete="username" /></label>
      <label>Password<input name="password" type="password" required autocomplete="current-password" /></label>
      <button type="submit">Sign in</button>
      <div class="error" id="err" role="alert"></div>
    </form>
    <p class="muted">New here? <a href="/sign-up">Create an account</a></p>
  </div>
</Base>

<script>
  import { authClient } from '../lib/auth-client';
  const form = document.getElementById('f') as HTMLFormElement;
  const err = document.getElementById('err')!;
  const next = form.dataset.next || '/hangar';
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.textContent = '';
    const d = new FormData(form);
    const login = String(d.get('login')).trim();
    const password = String(d.get('password'));
    const { data, error } = login.includes('@')
      ? await authClient.signIn.email({ email: login, password })
      : await authClient.signIn.username({ username: login, password });
    if (error) {
      err.textContent = error.message || 'Wrong username, email or password.';
      return;
    }
    // With 2FA on, the client plugin sends us to /two-factor instead.
    if (!(data as { twoFactorRedirect?: boolean })?.twoFactorRedirect) location.href = next;
  });
  document.querySelector('[data-social="discord"]')?.addEventListener('click', () =>
    authClient.signIn.social({ provider: 'discord', callbackURL: next }),
  );
</script>

<style>
  .discord {
    width: 100%;
    justify-content: center;
    background: #5865f2;
  }
  .or {
    text-align: center;
    margin: 12px 0;
  }
</style>
