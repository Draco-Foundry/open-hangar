---
import Base from '../layouts/Base.astro';
import { discordEnabled, SIGNUPS_CLOSED } from '../lib/auth';

export const prerender = false;
// Only same-site paths after sign-in (no open redirects).
const raw = Astro.url.searchParams.get('next') || '/hangar';
const next = raw.startsWith('/') && !raw.startsWith('//') ? raw : '/hangar';
if (Astro.locals.user) return Astro.redirect(next);
const discord = discordEnabled();
// Better Auth sends failed Discord logins back here with ?error=.
const oauthError = Astro.url.searchParams.get('error');
const oauthMessage =
  oauthError && /unable_to_create_user|signup|forbidden/i.test(oauthError)
    ? SIGNUPS_CLOSED
    : oauthError === 'account_not_linked'
    ? 'That Discord email already has an account here. Sign in with your password, confirm your email, then try Discord again.'
    : oauthError
      ? 'Discord login didn’t work. Try again, or use your email.'
      : '';
const reset = Astro.url.searchParams.has('reset');
---

<Base title="Sign In">
  <h1>Sign In</h1>
  {reset && <p class="ok">Password changed. Sign in with the new one.</p>}
  {oauthMessage && <p class="error">{oauthMessage}</p>}
  <div class="card" style="max-width:460px">
    {
      discord && (
        <>
          <button type="button" class="discord" data-social="discord">
            Log in with Discord
          </button>
          <p class="or muted">Or use your email</p>
        </>
      )
    }
    <form class="form" id="f" data-next={next}>
      <label>Email<input name="login" type="email" required autocomplete="email" /></label>
      <label>Password<input name="password" type="password" required autocomplete="current-password" /></label>
      <button type="submit">Sign in</button>
      <div class="error" id="err" role="alert"></div>
    </form>
    <p class="muted"><a href="/forgot-password">Forgot password?</a></p>
    <p class="muted">New here? <a href="/sign-up">Create an account</a></p>
  </div>
</Base>

<script>
  import { authClient } from '../lib/auth-client';
  const form = document.getElementById('f') as HTMLFormElement;
  const err = document.getElementById('err')!;
  const next = form.dataset.next || '/hangar';
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.textContent = '';
    const d = new FormData(form);
    const { data, error } = await authClient.signIn.email({
      email: String(d.get('login')).trim(),
      password: String(d.get('password')),
    });
    if (error) {
      err.textContent = error.message || 'Wrong email or password.';
      return;
    }
    // With 2FA on, the client plugin sends us to /two-factor instead.
    if (!(data as { twoFactorRedirect?: boolean })?.twoFactorRedirect) location.href = next;
  });
  document.querySelector('[data-social="discord"]')?.addEventListener('click', () =>
    authClient.signIn.social({ provider: 'discord', callbackURL: next, errorCallbackURL: '/sign-in' }),
  );
</script>

<style>
  .discord {
    width: 100%;
    justify-content: center;
    background: #5865f2;
  }
  .or {
    text-align: center;
    margin: 12px 0;
  }
</style>
