---
import Base from '../layouts/Base.astro';

export const prerender = false;
const raw = Astro.url.searchParams.get('next') || '/hangar';
const next = raw.startsWith('/') && !raw.startsWith('//') ? raw : '/hangar';
---

<Base title="Two-Factor Check">
  <h1>Enter Your Code</h1>
  <p class="muted">Open your authenticator app and type the 6-digit code for Open Hangar.</p>
  <div class="card" style="max-width:420px">
    <form class="form" id="f" data-next={next}>
      <label
        >Code<input name="code" inputmode="numeric" autocomplete="one-time-code" required maxlength="11" /></label
      >
      <label class="row"><input type="checkbox" name="trust" /> Trust this device for 30 days</label>
      <button type="submit">Verify</button>
      <div class="error" id="err" role="alert"></div>
    </form>
    <p class="muted">Lost your phone? Type one of your backup codes instead.</p>
  </div>
</Base>

<script>
  import { authClient } from '../lib/auth-client';
  const form = document.getElementById('f') as HTMLFormElement;
  const err = document.getElementById('err')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const code = String(d.get('code')).trim();
    const trustDevice = d.get('trust') === 'on';
    // 6 digits = authenticator code; anything else = a backup code.
    const { error } = /^\d{6}$/.test(code)
      ? await authClient.twoFactor.verifyTotp({ code, trustDevice })
      : await authClient.twoFactor.verifyBackupCode({ code, trustDevice });
    if (error) err.textContent = error.message || 'That code didn’t work.';
    else location.href = form.dataset.next || '/hangar';
  });
</script>

<style>
  .row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
</style>
