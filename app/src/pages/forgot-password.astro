---
import Base from '../layouts/Base.astro';

export const prerender = false;
---

<Base title="Forgot Password">
  <h1>Forgot Your Password?</h1>
  <p class="muted">Type your email and we'll send you a link to pick a new one.</p>
  <div class="card" style="max-width:460px">
    <form class="form" id="f">
      <label>Email<input name="email" type="email" required autocomplete="email" /></label>
      <button type="submit">Send reset link</button>
      <div class="error" id="err" role="alert"></div>
    </form>
    <p class="ok" id="done" hidden>
      If there's an account for that email, a reset link is on its way. It works for an hour.
    </p>
    <p class="muted"><a href="/sign-in">Back to sign in</a></p>
  </div>
</Base>

<script>
  import { authClient } from '../lib/auth-client';
  const form = document.getElementById('f') as HTMLFormElement;
  const err = document.getElementById('err')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.textContent = '';
    const { error } = await authClient.requestPasswordReset({
      email: String(new FormData(form).get('email')).trim(),
      redirectTo: '/reset-password',
    });
    if (error) {
      err.textContent = error.message || 'Could not send the link.';
      return;
    }
    form.hidden = true;
    document.getElementById('done')!.hidden = false;
  });
</script>
