---
import Base from '../layouts/Base.astro';

export const prerender = false;
// The link in the email passes through Better Auth, which lands here with
// ?token= (good link) or ?error=INVALID_TOKEN (used or expired).
const token = Astro.url.searchParams.get('token') || '';
const bad = !token || Astro.url.searchParams.has('error');
---

<Base title="Reset Password">
  <h1>Pick a New Password</h1>
  <div class="card" style="max-width:460px">
    {
      bad ? (
        <p class="error">
          That link is used up or expired. <a href="/forgot-password">Get a new one</a>.
        </p>
      ) : (
        <form class="form" id="f" data-token={token}>
          <label>
            New password (10+ characters)
            <input name="password" type="password" required minlength="10" autocomplete="new-password" />
          </label>
          <button type="submit">Save password</button>
          <div class="error" id="err" role="alert" />
        </form>
      )
    }
  </div>
</Base>

<script>
  import { authClient } from '../lib/auth-client';
  const form = document.getElementById('f') as HTMLFormElement | null;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = document.getElementById('err')!;
    err.textContent = '';
    const { error } = await authClient.resetPassword({
      newPassword: String(new FormData(form).get('password')),
      token: form.dataset.token!,
    });
    if (error) err.textContent = error.message || 'Could not save the password.';
    else location.href = '/sign-in?reset=1';
  });
</script>
