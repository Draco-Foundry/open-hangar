---
import Base from '../layouts/Base.astro';
import ThemePicker from '../components/ThemePicker.astro';
import { db } from '../lib/sync';

export const prerender = false;
const user = Astro.locals.user!;

// Revoke one extension connection (form post from this page).
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = String(form.get('revoke') || '');
  if (id) await db().prepare('delete from sync_token where id = ? and user_id = ?').bind(id, user.id).run();
  return Astro.redirect('/account');
}

const { results: tokens } = await db()
  .prepare('select id, label, created_at, last_used_at from sync_token where user_id = ? order by created_at desc')
  .bind(user.id)
  .all<{ id: string; label: string; created_at: number; last_used_at: number | null }>();
const day = (t: number | null) => (t ? new Date(t).toLocaleDateString('en-US', { dateStyle: 'medium' }) : 'never');
const welcome = Astro.url.searchParams.has('welcome');
---

<Base title="Account">
  <h1>Account</h1>
  {welcome && <p class="ok">Welcome aboard! Next: turn on two-factor below, then connect your extension.</p>}

  <section class="card">
    <h2 style="margin-top:0">Profile</h2>
    <p><strong>{user.email}</strong></p>
    <p class="muted">RSI handles will show here for each hangar you sync (your main and any alts).</p>
  </section>

  <section class="card" id="appearance">
    <h2 style="margin-top:0">Appearance</h2>
    <p class="muted">How the site looks for you, on every device you sign in on.</p>
    <ThemePicker />
  </section>

  <section class="card" id="tfa" data-enabled={user.twoFactorEnabled ? '1' : ''}>
    <h2 style="margin-top:0">Two-Factor Sign-In</h2>
    {
      user.twoFactorEnabled ? (
        <p class="ok">On. You'll be asked for a code from your authenticator app when you sign in.</p>
      ) : (
        <p class="muted">
          Adds a 6-digit code from an authenticator app (Google Authenticator, Authy, 1Password, …) to password
          sign-ins.
        </p>
      )
    }
    <form class="form" id="tfa-start">
      <label>Your password<input name="password" type="password" required autocomplete="current-password" /></label>
      <button type="submit" class={user.twoFactorEnabled ? 'danger' : ''}>
        {user.twoFactorEnabled ? 'Turn off two-factor' : 'Set up two-factor'}
      </button>
      <div class="error" id="tfa-err" role="alert"></div>
    </form>
    <div id="tfa-setup" hidden>
      <p>Scan this with your authenticator app, then type the code it shows.</p>
      <img id="tfa-qr" alt="QR code for your authenticator app" width="200" height="200" />
      <p class="muted">Can't scan? Enter this key: <code id="tfa-key"></code></p>
      <form class="form" id="tfa-verify">
        <label>6-digit code<input name="code" inputmode="numeric" maxlength="6" required /></label>
        <button type="submit">Turn it on</button>
        <div class="error" id="tfa-verr" role="alert"></div>
      </form>
      <p><strong>Backup codes</strong> (save these somewhere safe; each works once if you lose your phone):</p>
      <pre id="tfa-backup"></pre>
    </div>
  </section>

  <section class="card">
    <h2 style="margin-top:0">Connected Extensions</h2>
    {
      tokens.length ? (
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Connected</th>
              <th>Last sync</th>
              <th />
            </tr>
          </thead>
          <tbody>
            {tokens.map((t) => (
              <tr>
                <td>{t.label}</td>
                <td>{day(t.created_at)}</td>
                <td>{day(t.last_used_at)}</td>
                <td class="num">
                  <form method="post">
                    <button class="danger" name="revoke" value={t.id}>
                      Disconnect
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="muted">
          None yet. <a href="/link">Connect your extension</a> to sync your hangar here.
        </p>
      )
    }
  </section>

  <section class="card">
    <h2 style="margin-top:0">Delete Account</h2>
    <p class="muted">
      Removes your account, your synced hangar and every connected extension, right away. Your extension keeps
      working offline.
    </p>
    <form class="form" id="del">
      <label
        >Type your password to confirm<input
          name="password"
          type="password"
          autocomplete="current-password"
        /></label
      >
      <button type="submit" class="danger">Delete my account</button>
      <div class="error" id="del-err" role="alert"></div>
    </form>
  </section>
</Base>

<script>
  import QRCode from 'qrcode';
  import { authClient } from '../lib/auth-client';
  const $ = (id: string) => document.getElementById(id)!;
  const enabled = !!($('tfa') as HTMLElement).dataset.enabled;

  $('tfa-start').addEventListener('submit', async (e) => {
    e.preventDefault();
    const password = String(new FormData(e.target as HTMLFormElement).get('password'));
    $('tfa-err').textContent = '';
    if (enabled) {
      const { error } = await authClient.twoFactor.disable({ password });
      if (error) $('tfa-err').textContent = error.message || 'Could not turn it off.';
      else location.reload();
      return;
    }
    const { data, error } = await authClient.twoFactor.enable({ password });
    if (error || !data || data.method !== 'totp') {
      $('tfa-err').textContent = error?.message || 'Could not start setup.';
      return;
    }
    ($('tfa-qr') as HTMLImageElement).src = await QRCode.toDataURL(data.totpURI, { margin: 1, width: 200 });
    $('tfa-key').textContent = new URL(data.totpURI).searchParams.get('secret') || '';
    $('tfa-backup').textContent = data.backupCodes.join('\n');
    $('tfa-setup').hidden = false;
    $('tfa-start').hidden = true;
  });

  $('tfa-verify').addEventListener('submit', async (e) => {
    e.preventDefault();
    const code = String(new FormData(e.target as HTMLFormElement).get('code')).trim();
    const { error } = await authClient.twoFactor.verifyTotp({ code });
    if (error) $('tfa-verr').textContent = error.message || 'That code didn’t work.';
    else location.reload();
  });

  $('del').addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!confirm('Delete your account and synced data for good?')) return;
    const password = String(new FormData(e.target as HTMLFormElement).get('password') || '') || undefined;
    const { error } = await authClient.deleteUser({ password });
    if (error) $('del-err').textContent = error.message || 'Could not delete the account.';
    else location.href = '/';
  });
</script>

<style>
  section.card {
    margin: 16px 0;
  }
  pre {
    background: var(--panel-2);
    padding: 10px 14px;
    border-radius: 8px;
    display: inline-block;
  }
  #tfa-qr {
    background: #fff;
    padding: 6px;
    border-radius: 8px;
  }
</style>
