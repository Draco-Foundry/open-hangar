---
import Base from '../layouts/Base.astro';
import { db, normalizeCode } from '../lib/sync';

export const prerender = false;
const user = Astro.locals.user!;
let message = '';
let ok = false;
// The extension opens /link?code=K7Q-4PX so there's nothing to type.
const prefill = normalizeCode(Astro.url.searchParams.get('code') || '');

if (Astro.request.method === 'POST') {
  const code = normalizeCode(String((await Astro.request.formData()).get('code') || ''));
  const res = await db()
    .prepare(
      'update device_code set user_id = ?, approved_at = ? where user_code = ? and approved_at is null and expires_at > ?',
    )
    .bind(user.id, Date.now(), code, Date.now())
    .run();
  ok = res.meta.changes === 1;
  message = ok
    ? 'Connected! Your extension will pick it up in a few seconds.'
    : 'That code didn’t match or has expired. Get a fresh one from the extension.';
}
---

<Base title="Connect Your Extension">
  <h1>Connect Your Extension</h1>
  <p class="muted">
    {
      prefill && !message
        ? 'Your Open Hangar extension wants to connect to this account. Check the code matches the one in the extension, then press Connect.'
        : 'In Open Hangar, press Connect on the Home page. It opens this page with the code filled in (or shows a code like K7Q-4PX to type here).'
    }
  </p>
  <div class="card" style="max-width:420px">
    <form class="form" method="post">
      <label
        >Code<input
          name="code"
          value={ok ? '' : prefill}
          required
          maxlength="8"
          autocomplete="off"
          style="text-transform:uppercase;letter-spacing:3px;font-size:20px"
        /></label
      >
      <button type="submit">Connect</button>
      {message && <p class={ok ? 'ok' : 'error'}>{message}</p>}
    </form>
  </div>
  <p class="muted">
    Syncing is always your choice: the extension only sends your data when you press <strong>Sync now</strong>, and
    you can disconnect any time from <a href="/account">Account</a>.
  </p>
</Base>
