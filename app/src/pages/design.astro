---
import Base from '../layouts/Base.astro';
import ThemePicker from '../components/ThemePicker.astro';

export const prerender = false;
---

<Base title="Design" allFonts>
  <h1>Design</h1>
  <p class="muted">
    Pick a colour scheme, font and style. The page changes live and your choice follows you around the site. Signed
    in, it's saved to your account (Account → Appearance).
  </p>

  <div class="card"><ThemePicker /></div>

  <h2>Preview</h2>
  <div class="stat-grid">
    <div class="stat"><div class="big">202</div><div class="lbl">pledges</div></div>
    <div class="stat"><div class="big">$13,620.00</div><div class="lbl">melt value</div></div>
    <div class="stat"><div class="big">22</div><div class="lbl">with LTI</div></div>
    <div class="stat"><div class="big">1,065</div><div class="lbl">buy-backs</div></div>
  </div>

  <div class="two">
    <div class="card">
      <h2 style="margin-top:0">Most Valuable Pledges</h2>
      <table>
        <thead><tr><th>Pledge</th><th>Insurance</th><th class="num">Melt value</th></tr></thead>
        <tbody>
          <tr><td>Anvil Carrack</td><td>LTI</td><td class="num">$600.00</td></tr>
          <tr><td>Origin 400i</td><td>LTI</td><td class="num">$250.00</td></tr>
          <tr><td>Aegis Vanguard Sentinel</td><td>120 Months</td><td class="num">$275.00</td></tr>
          <tr><td>Drake Cutlass Black</td><td>6 Months</td><td class="num">$110.00</td></tr>
        </tbody>
      </table>
    </div>
    <div class="card">
      <h2 style="margin-top:0">Connect Your Extension</h2>
      <form class="form" onsubmit="return false">
        <label>Code<input value="K7Q-4PX" /></label>
        <div class="row">
          <button type="button">Connect</button>
          <button type="button" class="secondary">Cancel</button>
          <button type="button" class="danger">Disconnect</button>
        </div>
        <p class="ok">Connected! Your extension will pick it up in a few seconds.</p>
        <p class="muted">Syncing is always your choice. <a href="#">Learn more</a></p>
      </form>
    </div>
  </div>
</Base>



<style>
  .two {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 14px;
    margin-top: 14px;
  }
  .row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
</style>
