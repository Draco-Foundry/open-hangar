---
import Base from '../layouts/Base.astro';
import { discordEnabled, signupsOpen } from '../lib/auth';

export const prerender = false;
if (Astro.locals.user) return Astro.redirect('/hangar');
const discord = discordEnabled();
const open = signupsOpen();
---

<Base title="Create Account">
  <h1>Create Your Account</h1>
  <p class="muted">
    Optional: the extension works fine without one. An account lets you sync your hangar here, see it on any
    device, and (soon) join your org.
  </p>
  {
    !open && (
      <p class="notice">
        Accounts are invite-only while we get things ready. If you're on the tester list, sign up below; otherwise
        check back soon.
      </p>
    )
  }
  <div class="card" style="max-width:460px">
    {
      discord && (
        <>
          <button type="button" class="discord" data-social="discord">
            Log in with Discord
          </button>
          <p class="or muted">Or use your email</p>
        </>
      )
    }
    <form class="form" id="f">
      <label>Email<input name="email" type="email" required autocomplete="email" /></label>
      <label
        >Password (10+ characters)<input
          name="password"
          type="password"
          required
          minlength="10"
          autocomplete="new-password"
        /></label
      >
      <button type="submit">Create Account</button>
      <div class="error" id="err" role="alert"></div>
    </form>
    <p class="muted">We'll email you a link to confirm your address.</p>
    <p class="muted">Already have one? <a href="/sign-in">Sign in</a></p>
  </div>
</Base>

<script>
  import { authClient } from '../lib/auth-client';
  const form = document.getElementById('f') as HTMLFormElement;
  const err = document.getElementById('err')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.textContent = '';
    const d = new FormData(form);
    const email = String(d.get('email')).trim();
    const { error } = await authClient.signUp.email({
      // Better Auth needs a name; nobody sees it. RSI handles come from synced
      // hangars (one per RSI account, so alts don't clash).
      name: email.split('@')[0],
      email,
      password: String(d.get('password')),
      // Where the link in the confirmation email lands.
      callbackURL: '/account?verified=1',
    });
    if (error) err.textContent = error.message || 'Could not create the account.';
    else location.href = '/account?welcome=1';
  });
  document.querySelector('[data-social="discord"]')?.addEventListener('click', () =>
    authClient.signIn.social({
      provider: 'discord',
      callbackURL: '/hangar',
      errorCallbackURL: '/sign-in',
    }),
  );
</script>

<style>
  .notice {
    max-width: 460px;
    padding: 10px 14px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--line));
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--accent) 10%, var(--panel));
  }
  .discord {
    width: 100%;
    justify-content: center;
    background: #5865f2;
  }
  .or {
    text-align: center;
    margin: 12px 0;
  }
</style>
