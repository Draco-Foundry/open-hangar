{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "open-hangar-app",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-hangar",
      "database_id": "74bd4c7f-1ab3-4aab-b336-dd03482610d4",
      "migrations_dir": "migrations",
    },
  ],
  // Astro sessions (created by the first deploy).
  "kv_namespaces": [{ "binding": "SESSION", "id": "377406e2d7c043c499c92620a14d68da" }],
  // Secrets (`wrangler secret put NAME`; locally in .dev.vars):
  //   BETTER_AUTH_SECRET     required
  //   DISCORD_CLIENT_SECRET  Log in with Discord (needs DISCORD_CLIENT_ID too)
  //   RESEND_API_KEY         account emails; without it, links are logged instead
  //   SIGNUP_ALLOWLIST       optional: comma-separated emails allowed to sign up before launch
  // BETTER_AUTH_URL is overridden to http://localhost:4321 in .dev.vars for local dev.
  "vars": {
    "BETTER_AUTH_URL": "https://app.openhangar.space",
    // Discord application ID (public). Empty = Discord login hidden.
    "DISCORD_CLIENT_ID": "1554856207179714671",
    "EMAIL_FROM": "Open Hangar <noreply@openhangar.space>",
    // "true" opens account creation to everyone (launch day). Until then only
    // existing accounts and emails in the SIGNUP_ALLOWLIST secret can get in.
    "SIGNUPS_OPEN": "false",
  },
  // Served at app.openhangar.space (Cloudflare creates the DNS record and certificate).
  "routes": [{ "pattern": "app.openhangar.space", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
  // Staging (docs/WEBSITE-PLAN.md, Backend Foundation step 3): its own database and
  // session store at staging.openhangar.space, deployed on every push to main by
  // .github/workflows/deploy.yml. Sign-ups stay closed; Discord login stays hidden
  // (no client secret) and emails are only logged (no Resend key).
  "env": {
    "staging": {
      "name": "open-hangar-app-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "open-hangar-staging",
          "database_id": "b07d57f7-09dd-4618-b5ce-04e84d4a8431",
          "migrations_dir": "migrations",
        },
      ],
      "kv_namespaces": [{ "binding": "SESSION", "id": "47d0313c015d47c5852002b2db8798ac" }],
      "vars": {
        "BETTER_AUTH_URL": "https://staging.openhangar.space",
        "DISCORD_CLIENT_ID": "",
        "EMAIL_FROM": "Open Hangar Staging <noreply@openhangar.space>",
        "SIGNUPS_OPEN": "false",
      },
      "routes": [{ "pattern": "staging.openhangar.space", "custom_domain": true }],
    },
  },
}
