{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "open-hangar-app",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  // Replace database_id with the real one after `wrangler d1 create open-hangar`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-hangar",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // Secrets (`wrangler secret put NAME`; locally in .dev.vars):
  //   BETTER_AUTH_SECRET     required
  //   DISCORD_CLIENT_SECRET  Log in with Discord (needs DISCORD_CLIENT_ID too)
  //   RESEND_API_KEY         account emails; without it, links are logged instead
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:4321",
    // Discord application ID (public). Empty = Discord login hidden.
    "DISCORD_CLIENT_ID": "",
    "EMAIL_FROM": "Open Hangar <noreply@openhangar.space>",
  },
  "observability": {
    "enabled": true,
  },
}
