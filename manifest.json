{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "version": "0.3.1",
  "author": "Draco Foundry",
  "homepage_url": "https://openhangar.space",
  "permissions": ["storage", "unlimitedStorage", "cookies", "identity"],
  "host_permissions": ["https://robertsspaceindustries.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Open Hangar"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "Alt+Shift+H"
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
