{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "version": "0.2.13",
  "author": "Draco Foundry",
  "homepage_url": "https://github.com/Draco-Foundry/open-hangar",
  "permissions": ["storage", "unlimitedStorage", "cookies"],
  "host_permissions": ["https://robertsspaceindustries.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Open Hangar"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
