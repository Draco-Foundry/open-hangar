{
  "manifest_version": 3,
  "name": "Open Hangar",
  "description": "Read your own Star Citizen / RSI hangar, buy-backs, balances & referrals into a clean, local, exportable database.",
  "version": "0.2.6",
  "author": "Draco Foundry",
  "homepage_url": "https://github.com/Draco-Foundry/open-hangar",
  "permissions": ["storage", "cookies"],
  "host_permissions": ["https://robertsspaceindustries.com/*", "https://api.star-citizen.wiki/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Open Hangar"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
