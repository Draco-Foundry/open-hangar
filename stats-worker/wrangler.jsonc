{
  "$schema": "../app/node_modules/wrangler/config-schema.json",
  "name": "open-hangar-stats",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  // No public URL: the Worker only runs on its cron.
  "workers_dev": false,
  "preview_urls": false,
  // Store stats at 7am Boise (MDT, 6am in winter); the watchdog every 5 minutes.
  "triggers": { "crons": ["0 13 * * *", "*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-hangar-stats",
      "database_id": "562a2666-3fc4-40db-9ef3-3591c32c388c",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true },
}
